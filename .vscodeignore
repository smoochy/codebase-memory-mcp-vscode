.vscode/**
.worktrees/**
.superpowers/**
node_modules/**
out/**
src/**
test/**
esbuild.mjs
tsconfig*.json
.mocharc.json
.eslintrc*
**/*.map
# The shipped artifact is the bundled dist/extension.js, so no TypeScript
# should ever be packaged. The src/ and test/ rules cover today's layout;
# this catches a stray .ts added at the root later.
**/*.ts
# Developer tooling; nothing in dist/ requires it.
scripts/**
# Repository metadata, meaningless inside an installed extension.
.gitignore
# Scratch files from local preview/probe runs.
.tmp-*
