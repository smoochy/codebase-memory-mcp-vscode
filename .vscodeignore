.vscode/**
.worktrees/**
.superpowers/**
node_modules/**
out/**
src/**
test/**
esbuild.mjs
tsconfig*.json
.mocharc.json
.eslintrc*
**/*.map
# The shipped artifact is the bundled dist/extension.js, so no TypeScript
# should ever be packaged. The src/ and test/ rules cover today's layout;
# this catches a stray .ts added at the root later.
**/*.ts
# Developer tooling; nothing in dist/ requires it.
scripts/**
# Build input for media/icon.png. The manifest points the listing at the PNG,
# so the vector source is only needed to regenerate it.
media/icon-marketplace.svg
# README screenshots. The marketplace renders them from their absolute
# raw.githubusercontent URLs, so the files themselves need not be packaged.
assets/**
# Repository metadata, meaningless inside an installed extension.
.gitignore
.github/**
# Scratch files from local preview/probe runs.
.tmp-*
# Reports written by scripts/autotest.mjs. The harness packages the extension
# from a working tree that already holds its own earlier reports, so without
# this the run ships its own output inside the artifact it is testing.
.autotest/**
