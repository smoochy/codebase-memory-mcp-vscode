{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "skipLibCheck": true,
    // TypeScript 7 no longer sweeps node_modules/@types automatically, so every
    // type package this project relies on has to be named here.
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
